# Copy to .env and adjust. Compose picks .env up automatically.
POSTGRES_DB=galactic
POSTGRES_USER=galactic
POSTGRES_PASSWORD=change-me

# Host port the game is served on.
GE_PORT=4004

# Names that may start and delete any game, comma separated. Optional -
# without it only a game's creator can start or delete it.
GE_GAMEMASTERS=
