{
  "name": "galactic-empire",
  "version": "0.1.0",
  "description": "Turn-based multiplayer space conquest game - CAP backend",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@cap-js/hana": "^2",
    "@cap-js/postgres": "^2.3.0",
    "@sap/cds": "^9",
    "@sap/xssec": "^4",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^0",
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^10"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "test": "node --test \"test/*.test.js\"",
    "deploy": "cds deploy --to sqlite:db.sqlite",
    "test:ui": "node test/ui-smoke.mjs"
  },
  "cds": {
    "requires": {
      "db": {
        "[development]": {
          "kind": "sqlite",
          "credentials": {
            "url": "db.sqlite"
          }
        },
        "[docker]": {
          "kind": "postgres"
        }
      },
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "alice": {
              "roles": [
                "player"
              ]
            },
            "bob": {
              "roles": [
                "player"
              ]
            },
            "carol": {
              "roles": [
                "player"
              ]
            },
            "dave": {
              "roles": [
                "player"
              ]
            },
            "admin": {
              "roles": [
                "player",
                "gamemaster"
              ]
            }
          }
        },
        "[docker]": {
          "impl": "srv/auth/open-auth.js"
        }
      },
      "[btp]": {
        "auth": {
          "kind": "xsuaa"
        },
        "db": {
          "kind": "hana"
        }
      }
    },
    "features": {
      "assert_integrity": false
    }
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
